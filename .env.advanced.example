# 白泽公开部署高级配置模板
#
# 使用方式：
#   1) 不要直接把本文件改名为 .env。
#   2) 只把你需要调整的条目复制到 .env。
#   3) 复制后去掉行首 #，再按说明填写。
#
# 边界说明：
#   - 保持注释时使用白泽内置默认值。
#   - 这些项主要用于大规模部署、性能压测、合规接入或排障。
#   - 授权中心身份、签名材料、刷新周期和订阅升级入口刻意不在这里暴露；这些值由白泽激活流程、系统托管配置和签名授权状态维护。
#   - 值中包含空格、#、$、&、;、|、<、>、括号、反引号或反斜杠时，复制到 .env 后请使用单引号。

# ============================================================
# 一、数据库连接池与结构版本记录
# ============================================================

# 目的：控制服务数据库连接池最大打开连接数。
# 作用域：控制服务进程。
# 填写：默认 50；小型部署 20-60，调大前确认数据库最大连接数。
# DB_MAX_OPEN_CONNS=50

# 目的：控制服务数据库连接池最大空闲连接数。
# 作用域：控制服务进程。
# 填写：默认 10；必须小于或等于 DB_MAX_OPEN_CONNS。
# DB_MAX_IDLE_CONNS=10

# 目的：数据库连接最大生命周期。
# 作用域：控制服务进程。
# 填写：单位秒，默认 1800；0 表示不按生命周期主动回收。
# DB_CONN_MAX_LIFETIME_SEC=1800

# 目的：数据库空闲连接最大保留时间。
# 作用域：控制服务进程。
# 填写：单位秒，默认 600；0 表示不按空闲时间主动回收。
# DB_CONN_MAX_IDLE_TIME_SEC=600

# 目的：SQL 日志级别。
# 作用域：控制服务进程。
# 填写：silent、error、warn、info 或 debug；生产建议 warn 或 error。
# DB_GORM_LOG_LEVEL=warn

# 目的：数据库结构版本记录表名覆盖。
# 作用域：控制服务进程。
# 填写：通常留空使用默认表；只有自管数据库升级流程时才设置。
# BAIZE_DB_MIGRATION_TABLE=

# 目的：Redis 是否作为启动和健康检查的强依赖。
# 作用域：控制服务进程。
# 填写：生产保持 true；仅应急排障或极小试用场景临时设 false。
# BAIZE_REDIS_REQUIRED=true

# ============================================================
# 二、CORS 细项
# ============================================================

# 目的：允许的跨域 HTTP 方法。
# 作用域：控制服务进程。
# 填写：默认覆盖当前控制台请求；新增自定义调用方式时再调整。
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# 目的：允许浏览器发送的跨域请求头。
# 作用域：控制服务进程。
# 填写：新增自定义鉴权头或代理头时再补充。
# CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,Cache-Control,Pragma

# 目的：允许浏览器读取的响应头。
# 作用域：控制服务进程。
# 填写：只有控制台需要读取额外响应头时才设置。
# CORS_EXPOSE_HEADERS=Content-Length,Content-Type

# 目的：浏览器预检请求缓存时间。
# 作用域：控制服务进程。
# 填写：单位秒，默认 86400；联调跨域问题时可临时调小。
# CORS_MAX_AGE=86400

# ============================================================
# 三、密钥隔离与高敏操作保护
# ============================================================

# 目的：通知渠道配置专用加密主密钥。
# 作用域：控制服务通知配置加解密。
# 填写：可留空回退 CREDENTIAL_MASTER_KEY；独立安全域部署时设置。
# NOTIFICATION_MASTER_KEY=

# 目的：AI 模型供应商密钥专用加密主密钥。
# 作用域：控制服务 AI 供应商配置加解密。
# 填写：可留空回退 CREDENTIAL_MASTER_KEY；独立安全域部署时设置。
# AI_PROVIDER_MASTER_KEY=

# 目的：控制服务下行控制消息签名私钥路径。
# 作用域：控制服务进程。
# 填写：生产必须使用持久化路径；丢失会影响已纳管 Agent 的信任关系。
# BAIZE_SERVER_SIGNING_KEY_PATH=/app/data/keys/server_ed25519.key

# 目的：主机画像高敏操作调试豁免。
# 作用域：控制服务高敏操作门禁。
# 填写：仅本地开发或自动化验证使用；生产必须保持 0 或不配置。
# BAIZE_HOST_PROFILE_DEBUG_BYPASS=0

# 目的：命令历史明文查看加密 key 标识。
# 作用域：控制服务主机画像历史敏感字段加解密。
# 填写：默认 server-local；多 key 轮换时填写可审计标识。
# HOST_PROFILE_HISTORY_CIPHER_KEY_ID=server-local

# 目的：命令历史明文查看加密 key。
# 作用域：控制服务主机画像历史敏感字段加解密。
# 填写：32 字节原文或 32 字节 base64/base64url；含特殊字符时使用单引号。
# HOST_PROFILE_HISTORY_CIPHER_KEY=

# ============================================================
# 四、GeoIP 在线回退
# ============================================================

# 目的：在线 GeoIP 查询模板。
# 作用域：控制服务 IP 归属解析。
# 填写：仅 GEOIP_OFFLINE_ONLY=false 且离线库未命中时使用；必须包含 %s 作为 IP 占位。
# GEOIP_LOOKUP_TEMPLATE=https://ipwho.is/%s

# 目的：在线 GeoIP 查询超时时间。
# 作用域：控制服务 IP 归属解析。
# 填写：单位毫秒，默认 3000；外部服务慢时不要无限调大。
# GEOIP_LOOKUP_TIMEOUT_MS=3000

# ============================================================
# 五、WAF 默认策略与版本门槛
# ============================================================

# 目的：WAF 总开关。
# 作用域：控制服务安全策略和下发逻辑。
# 填写：默认 false；完成灰度验证前不要在生产开启。
# WAF_ENABLED=false

# 目的：WAF 默认模式。
# 作用域：控制服务安全策略和下发逻辑。
# 填写：disabled、observe 或 enforce；拼写错误会降级。
# WAF_DEFAULT_MODE=disabled

# 目的：默认规则集版本。
# 作用域：控制服务安全策略和下发逻辑。
# 填写：为空表示不预置默认规则集；按发布说明填写。
# WAF_DEFAULT_RULE_SET_VERSION=

# 目的：WAF 事件采样率。
# 作用域：控制服务 WAF 事件处理。
# 填写：1 表示全量，0.1 约为 10%；调低前确认审计要求。
# WAF_EVENT_SAMPLE_RATE=1

# 目的：允许 Agent 进入观察态的最低版本。
# 作用域：控制服务 WAF 策略。
# 填写：默认 0.1.6；灰度期间不要临时调低。
# WAF_MIN_OBSERVE_VERSION=0.1.6

# 目的：允许 Agent 进入阻断态的最低版本。
# 作用域：控制服务 WAF 策略。
# 填写：默认 0.1.7；未完成阻断验收前不要调低。
# WAF_MIN_BLOCK_VERSION=0.1.7

# 目的：WAF 策略协议版本。
# 作用域：控制服务与 Agent WAF 能力协商。
# 填写：当前保持 waf.v1；变更前必须确认所有组件兼容。
# WAF_CONTRACT_VERSION=waf.v1

# ============================================================
# 六、AI 上下文与外部模型
# ============================================================

# 目的：AI 上下文能力部署默认开关。
# 作用域：控制服务进程；控制台保存设置后以系统设置为准。
# 填写：默认 false；确认模型供应商和数据边界后再开启。
# BAIZE_AI_CONTEXT_ENABLED=false

# 目的：部署层强制关闭 AI 上下文能力。
# 作用域：控制服务进程。
# 填写：生产应急或合规要求关闭时设 true。
# BAIZE_AI_CONTEXT_FORCE_DISABLED=false

# 目的：AI 推荐 provider。
# 作用域：控制服务进程。
# 填写：local_rules 使用本地规则；http_json 调用外部 HTTP JSON 模型接口。
# BAIZE_AI_RECOMMENDATION_PROVIDER=local_rules

# 目的：外部模型名称。
# 作用域：控制服务 AI 请求。
# 填写：仅 http_json provider 使用；包含空格时使用单引号。
# BAIZE_AI_MODEL_NAME=

# 目的：外部模型 HTTP JSON endpoint。
# 作用域：控制服务 AI 请求。
# 填写：完整 http(s) URL；包含查询串时使用单引号。
# BAIZE_AI_MODEL_ENDPOINT=

# 目的：外部模型 API Key。
# 作用域：控制服务 AI 请求，不返回给控制台。
# 填写：包含特殊字符时使用单引号；长期保存建议在控制台内加密保存。
# BAIZE_AI_MODEL_API_KEY=

# 目的：外部模型请求超时时间。
# 作用域：控制服务 AI 请求。
# 填写：单位秒，默认 15。
# BAIZE_AI_MODEL_TIMEOUT_SEC=15

# 目的：外部模型建议输出上限。
# 作用域：控制服务 AI 请求。
# 填写：单位 token，默认 800；具体含义取决于供应商。
# BAIZE_AI_MODEL_MAX_TOKENS=800

# ============================================================
# 七、远程执行输出边界
# ============================================================

# 目的：单个执行目标最多保留的输出字节数。
# 作用域：控制服务远程执行输出存储。
# 填写：默认 1048576，即 1 MiB；调大前评估批量任务总容量。
# BAIZE_EXEC_OUTPUT_MAX_BYTES=1048576

# 目的：执行输出明细保留天数。
# 作用域：控制服务远程执行输出清理。
# 填写：默认 30；小于等于 0 表示关闭定期清理。
# BAIZE_EXEC_OUTPUT_RETENTION_DAYS=30

# 目的：执行输出清理周期。
# 作用域：控制服务远程执行输出清理。
# 填写：单位分钟，默认 360。
# BAIZE_EXEC_OUTPUT_CLEANUP_INTERVAL_MINUTES=360

# 目的：输出读取默认片段数。
# 作用域：控制服务远程执行输出查询。
# 填写：默认 200；页面响应变慢时不要盲目调大。
# BAIZE_EXEC_OUTPUT_QUERY_DEFAULT_LIMIT=200

# 目的：输出读取最大片段数。
# 作用域：控制服务远程执行输出查询。
# 填写：默认 1000；运行期仍有硬上限。
# BAIZE_EXEC_OUTPUT_QUERY_MAX_LIMIT=1000

# 目的：输出读取默认目标数。
# 作用域：控制服务远程执行输出查询。
# 填写：默认 50；批量任务建议分页。
# BAIZE_EXEC_OUTPUT_TARGET_DEFAULT_LIMIT=50

# 目的：输出读取最大目标数。
# 作用域：控制服务远程执行输出查询。
# 填写：默认 200；目标很多时优先分页。
# BAIZE_EXEC_OUTPUT_TARGET_MAX_LIMIT=200

# ============================================================
# 八、Dashboard、Nginx 分析与操作审计
# ============================================================

# 目的：Dashboard 预聚合周期。
# 作用域：控制服务 Dashboard 后台聚合。
# 填写：单位秒，默认 15；调小会增加数据库压力。
# BAIZE_DASHBOARD_AGG_INTERVAL_SECONDS=15

# 目的：Dashboard 缓存 TTL。
# 作用域：控制服务 Dashboard 缓存。
# 填写：单位秒，默认 30；通常至少覆盖两轮聚合。
# BAIZE_DASHBOARD_CACHE_TTL_SECONDS=30

# 目的：每轮最多刷新多少个活跃分组。
# 作用域：控制服务 Dashboard 后台聚合。
# 填写：默认 10；分组很多且数据库有余量时再调大。
# BAIZE_DASHBOARD_GROUP_REFRESH_BATCH_SIZE=10

# 目的：分组被访问后保持活跃的时间。
# 作用域：控制服务 Dashboard 后台聚合。
# 填写：单位分钟，默认 10。
# BAIZE_DASHBOARD_GROUP_ACTIVE_TTL_MINUTES=10

# 目的：活跃分组注册表最大容量。
# 作用域：控制服务 Dashboard 后台聚合。
# 填写：默认 500；超过后淘汰最久未访问分组。
# BAIZE_DASHBOARD_GROUP_MAX_ACTIVE=500

# 目的：启动时是否预热全部分组。
# 作用域：控制服务 Dashboard 后台聚合。
# 填写：大规模生产建议 false；小规模可设 true 提前填充缓存。
# BAIZE_DASHBOARD_GROUP_PREWARM_ON_START=false

# 目的：Nginx 分析表选择缓存 TTL。
# 作用域：控制服务 Nginx 分析查询。
# 填写：单位秒，默认 10。
# BAIZE_NGINX_ANALYSIS_TABLE_CACHE_TTL_SECONDS=10

# 目的：Nginx 分析表选择缓存容量。
# 作用域：控制服务 Nginx 分析查询。
# 填写：默认 512；按 Agent、主机集合和时间窗口隔离。
# BAIZE_NGINX_ANALYSIS_TABLE_CACHE_MAX_ENTRIES=512

# 目的：操作审计异步落库队列容量。
# 作用域：控制服务操作审计中间件。
# 填写：默认 1024；审计队列满并出现丢弃时再调大。
# BAIZE_OPERATION_AUDIT_QUEUE_CAPACITY=1024

# 目的：操作审计异步落库 worker 数。
# 作用域：控制服务操作审计中间件。
# 填写：默认 2；受数据库写入能力约束。
# BAIZE_OPERATION_AUDIT_WORKERS=2

# ============================================================
# 九、运行日志与外部导出
# ============================================================

# 目的：诊断包默认收集最近多少行运行日志。
# 作用域：控制服务诊断包。
# 填写：默认 1000；诊断包过大时调低。
# BAIZE_RUNTIME_LOG_DIAGNOSTIC_LINES=1000

# 目的：运行日志热索引保留时间。
# 作用域：控制服务运行日志索引。
# 填写：单位小时，默认 168。
# BAIZE_RUNTIME_LOG_INDEX_RETENTION_HOURS=168

# 目的：运行日志热索引异步队列长度。
# 作用域：控制服务运行日志索引。
# 填写：默认 4096；日志突增且有丢弃时再调大。
# BAIZE_RUNTIME_LOG_INDEX_QUEUE_SIZE=4096

# 目的：是否启用外部日志导出。
# 作用域：控制服务运行日志导出。
# 填写：默认 false；接入外部日志平台后再开启。
# BAIZE_RUNTIME_LOG_EXPORT_ENABLED=false

# 目的：外部日志导出格式。
# 作用域：控制服务运行日志导出。
# 填写：http_json 或 loki；需与接收端匹配。
# BAIZE_RUNTIME_LOG_EXPORT_FORMAT=http_json

# 目的：外部日志导出 endpoint。
# 作用域：控制服务运行日志导出。
# 填写：完整 http(s) URL；包含查询串时使用单引号。
# BAIZE_RUNTIME_LOG_EXPORT_ENDPOINT=

# 目的：外部日志导出附加请求头。
# 作用域：控制服务运行日志导出。
# 填写：格式 Key=Value,Key2=Value2；包含空格或特殊字符时使用单引号。
# BAIZE_RUNTIME_LOG_EXPORT_HEADERS=

# 目的：外部日志导出批量条数。
# 作用域：控制服务运行日志导出。
# 填写：默认 100；接收端限流时调小。
# BAIZE_RUNTIME_LOG_EXPORT_BATCH_SIZE=100

# 目的：外部日志导出异步队列长度。
# 作用域：控制服务运行日志导出。
# 填写：默认 4096；日志突增且有丢弃时再调大。
# BAIZE_RUNTIME_LOG_EXPORT_QUEUE_SIZE=4096

# 目的：外部日志导出刷新间隔。
# 作用域：控制服务运行日志导出。
# 填写：单位秒，默认 5。
# BAIZE_RUNTIME_LOG_EXPORT_INTERVAL_SEC=5

# ============================================================
# 十、版本展示覆盖值
# ============================================================

# 目的：Agent 版本覆盖值。
# 作用域：版本展示。
# 填写：通常由发布清单提供；手工部署缺少构建信息时才填写。
# BAIZE_AGENT_VERSION=0.1.39

# 目的：控制服务构建指纹。
# 作用域：诊断、授权激活和版本追溯。
# 填写：通常由构建流程注入；手工填写时使用可追溯构建编号。
# BAIZE_SERVER_BUILD_FINGERPRINT=

# ============================================================
# 十一、后台调度器
# ============================================================

# 目的：心跳检查周期。
# 作用域：控制服务心跳检查调度。
# 填写：单位秒，默认 15；过小会增加数据库和调度压力。
# HB_CHECK_INTERVAL_SEC=15

# 目的：心跳超时阈值。
# 作用域：控制服务心跳检查调度。
# 填写：单位秒，默认 90。
# HB_CHECK_TIMEOUT_SEC=90

# 目的：心跳采样入库周期。
# 作用域：控制服务心跳采样调度。
# 填写：单位秒，默认 3600。
# HB_SAMPLE_INTERVAL_SEC=3600

# 目的：证书扫描调度开关。
# 作用域：控制服务证书扫描。
# 填写：默认 true；不使用证书监控时可关闭。
# CERT_SCAN_ENABLED=true

# 目的：证书扫描周期。
# 作用域：控制服务证书扫描。
# 填写：单位秒，默认 300。
# CERT_SCAN_INTERVAL_SEC=300

# 目的：证书扫描并发数。
# 作用域：控制服务证书扫描。
# 填写：默认 4；调大前确认网络和 CPU 余量。
# CERT_SCAN_CONCURRENCY=4

# 目的：证书扫描失败重试次数。
# 作用域：控制服务证书扫描。
# 填写：默认 2。
# CERT_SCAN_RETRIES=2

# 目的：证书扫描重试间隔。
# 作用域：控制服务证书扫描。
# 填写：单位秒，默认 3。
# CERT_SCAN_RETRY_DELAY_SEC=3

# 目的：告警发送失败后的后台重试开关。
# 作用域：控制服务告警重试调度。
# 填写：默认 true。
# ALERT_RETRY_ENABLED=true

# 目的：告警重试周期。
# 作用域：控制服务告警重试调度。
# 填写：单位秒，默认 60。
# ALERT_RETRY_INTERVAL_SEC=60

# 目的：告警重试回看窗口。
# 作用域：控制服务告警重试调度。
# 填写：单位小时，默认 24。
# ALERT_RETRY_LOOKBACK_HOURS=24

# 目的：每轮告警重试候选上限。
# 作用域：控制服务告警重试调度。
# 填写：默认 100。
# ALERT_RETRY_MAX_CANDIDATES=100

# 目的：单条告警最大重试次数。
# 作用域：控制服务告警重试调度。
# 填写：默认 3。
# ALERT_RETRY_MAX_ATTEMPTS=3

# 目的：告警升级调度开关。
# 作用域：控制服务告警升级调度。
# 填写：默认 true；排障时可临时关闭。
# ALERT_ESCALATION_ENABLED=true

# 目的：告警升级扫描周期。
# 作用域：控制服务告警升级调度。
# 填写：单位秒，默认 30。
# ALERT_ESCALATION_INTERVAL_SEC=30

# 目的：每轮告警升级候选上限。
# 作用域：控制服务告警升级调度。
# 填写：默认 100。
# ALERT_ESCALATION_MAX_CANDIDATES=100

# 目的：指标阈值告警检查开关。
# 作用域：控制服务指标阈值检查。
# 填写：默认 true；压测或排障时可临时关闭。
# ALERT_METRIC_THRESHOLD_ENABLED=true

# 目的：指标阈值告警检查周期。
# 作用域：控制服务指标阈值检查。
# 填写：单位秒，默认 30。
# ALERT_METRIC_THRESHOLD_INTERVAL_SEC=30

# 目的：每轮租约的定时任务数量。
# 作用域：控制服务分布式定时任务调度。
# 填写：默认 20；任务积压时按数据库能力调大。
# CRON_SCHEDULER_BATCH_SIZE=20

# 目的：定时任务租约时长。
# 作用域：控制服务分布式定时任务调度。
# 填写：单位秒，默认 120。
# CRON_SCHEDULER_LEASE_SEC=120

# 目的：目标繁忙后的退避时间。
# 作用域：控制服务分布式定时任务调度。
# 填写：单位秒，默认 60。
# CRON_SCHEDULER_BUSY_BACKOFF_SEC=60

# 目的：任务失败后的基础退避时间。
# 作用域：控制服务分布式定时任务调度。
# 填写：单位秒，默认 60。
# CRON_SCHEDULER_FAILURE_BASE_BACKOFF_SEC=60

# 目的：任务失败后的最大退避时间。
# 作用域：控制服务分布式定时任务调度。
# 填写：单位秒，默认 1800。
# CRON_SCHEDULER_FAILURE_MAX_BACKOFF_SEC=1800

# 目的：连续失败达到多少次后进入保护。
# 作用域：控制服务分布式定时任务调度。
# 填写：默认 5。
# CRON_SCHEDULER_MAX_FAILURES=5

# 目的：单个 Agent 同时承载的活跃目标上限。
# 作用域：控制服务分布式定时任务调度。
# 填写：默认 1；远程执行压力较高时保持默认。
# CRON_SCHEDULER_MAX_ACTIVE_TARGETS_PER_AGENT=1

# 目的：定时任务调度 worker 标识。
# 作用域：控制服务分布式定时任务调度。
# 填写：多实例部署可显式填写唯一值；单实例可留空。
# CRON_SCHEDULER_WORKER_ID=

# 目的：请求风险评估调度开关。
# 作用域：控制服务请求风险评估调度。
# 填写：默认 true；需要临时关闭评估时设 false。
# REQUEST_RISK_EVALUATOR_ENABLED=true

# 目的：请求风险评估周期。
# 作用域：控制服务请求风险评估调度。
# 填写：单位秒，默认 60。
# REQUEST_RISK_EVALUATOR_INTERVAL_SEC=60

# 目的：每轮请求风险评估处理上限。
# 作用域：控制服务请求风险评估调度。
# 填写：默认 200；高并发环境按数据库能力调优。
# REQUEST_RISK_EVALUATOR_LIMIT=200

# 目的：命令审批过期归档开关。
# 作用域：控制服务命令审批归档调度。
# 填写：默认 true；只在排障时临时关闭。
# COMMAND_PLAN_APPROVAL_EXPIRY_ENABLED=true

# 目的：命令审批过期归档扫描周期。
# 作用域：控制服务命令审批归档调度。
# 填写：单位秒，默认 300。
# COMMAND_PLAN_APPROVAL_EXPIRY_INTERVAL_SEC=300

# 目的：每轮归档的过期审批数量。
# 作用域：控制服务命令审批归档调度。
# 填写：默认 50。
# COMMAND_PLAN_APPROVAL_EXPIRY_BATCH_SIZE=50

# 目的：Runbook 后台自动推进开关。
# 作用域：控制服务 Runbook 调度。
# 填写：默认 false；未完成编排验收前保持关闭。
# RUNBOOK_SCHEDULER_ENABLED=false

# 目的：Runbook 后台推进周期。
# 作用域：控制服务 Runbook 调度。
# 填写：单位秒，默认 60。
# RUNBOOK_SCHEDULER_INTERVAL_SEC=60

# 目的：每轮扫描的 Runbook 实例数量。
# 作用域：控制服务 Runbook 调度。
# 填写：默认 20。
# RUNBOOK_SCHEDULER_BATCH_SIZE=20

# 目的：单个 Runbook 实例每轮最多推进步数。
# 作用域：控制服务 Runbook 调度。
# 填写：默认 8，避免一个实例长期占用调度循环。
# RUNBOOK_SCHEDULER_MAX_TICKS_PER_INSTANCE=8

# 目的：Runbook 调度租约时长。
# 作用域：控制服务 Runbook 调度。
# 填写：单位秒，默认 120。
# RUNBOOK_SCHEDULER_LEASE_SEC=120

# 目的：Runbook 调度 worker 标识。
# 作用域：控制服务 Runbook 调度。
# 填写：多实例部署可显式填写唯一值；单实例可留空。
# RUNBOOK_SCHEDULER_WORKER_ID=

# ============================================================
# 十二、WebSocket 入库队列与并发
# ============================================================

# 目的：系统指标入库队列容量。
# 作用域：控制服务实时指标处理。
# 填写：默认 256；大量 Agent 且队列丢弃时再调大。
# WS_METRICS_QUEUE_CAPACITY=256

# 目的：系统指标入库 worker 数。
# 作用域：控制服务实时指标处理。
# 填写：默认 8；受数据库写入能力约束。
# WS_METRICS_INSERT_WORKERS=8

# 目的：系统指标批量入库大小。
# 作用域：控制服务实时指标处理。
# 填写：默认 32；写入延迟和批量效率需要一起观察。
# WS_METRICS_INSERT_BATCH_SIZE=32

# 目的：单个 Agent 同时排队的系统指标批次上限。
# 作用域：控制服务实时指标处理。
# 填写：默认 32；不要调得过大以免挤占其他 Agent。
# WS_METRICS_MAX_QUEUED_PER_AGENT=32

# 目的：Nginx 指标入库队列容量。
# 作用域：控制服务 Nginx 指标处理。
# 填写：默认 128；大量 Agent 且队列丢弃时再调大。
# WS_NGINX_QUEUE_CAPACITY=128

# 目的：Nginx 指标入库 worker 数。
# 作用域：控制服务 Nginx 指标处理。
# 填写：默认 4。
# WS_NGINX_INSERT_WORKERS=4

# 目的：进程指标入库队列容量。
# 作用域：控制服务进程指标处理。
# 填写：默认 128；大量 Agent 且队列丢弃时再调大。
# WS_PROCESS_QUEUE_CAPACITY=128

# 目的：进程指标入库 worker 数。
# 作用域：控制服务进程指标处理。
# 填写：默认 4。
# WS_PROCESS_WORKERS=4

# 目的：Docker 指标入库队列容量。
# 作用域：控制服务 Docker 指标处理。
# 填写：默认 128；容器很多且队列满时再调大。
# WS_DOCKER_QUEUE_CAPACITY=128

# 目的：Docker 指标入库 worker 数。
# 作用域：控制服务 Docker 指标处理。
# 填写：默认 4。
# WS_DOCKER_WORKERS=4

# 目的：单次 Docker 上报最多处理的容器数量。
# 作用域：控制服务 Docker 指标处理。
# 填写：默认 500；超出部分会被丢弃并记录统计。
# WS_DOCKER_MAX_CONTAINERS_PER_PAYLOAD=500

# 目的：Docker 事件去重窗口。
# 作用域：控制服务 Docker 指标处理。
# 填写：单位秒，默认 60；0 表示不按窗口去重。
# WS_DOCKER_EVENT_DEDUPE_SECONDS=60

# 目的：WAF 事件入库队列容量。
# 作用域：控制服务 WAF 事件处理。
# 填写：默认 512；大量事件积压时再调大。
# WS_WAF_EVENT_QUEUE_CAPACITY=512

# 目的：WAF 事件入库 worker 数。
# 作用域：控制服务 WAF 事件处理。
# 填写：默认 4；受数据库写入能力约束。
# WS_WAF_EVENT_WORKERS=4

# 目的：WAF 事件副作用队列容量。
# 作用域：控制服务 WAF 告警和联防副作用处理。
# 填写：默认 512。
# WS_WAF_EVENT_SIDE_EFFECT_QUEUE_CAPACITY=512

# 目的：WAF 事件副作用 worker 数。
# 作用域：控制服务 WAF 告警和联防副作用处理。
# 填写：默认 2。
# WS_WAF_EVENT_SIDE_EFFECT_WORKERS=2

# 目的：单个 Agent 同时排队的 WAF 事件批次上限。
# 作用域：控制服务 WAF 事件处理。
# 填写：默认 64；防止单个 Agent 挤占全部队列。
# WS_WAF_EVENT_MAX_QUEUED_PER_AGENT=64

# 目的：WAF 事件站点 ID 缓存时间。
# 作用域：控制服务 WAF 事件处理。
# 填写：单位秒，默认 30；0 表示不缓存。
# WS_WAF_EVENT_SITE_CACHE_SECONDS=30

# 目的：WAF 事件副作用去重窗口。
# 作用域：控制服务 WAF 告警和联防副作用处理。
# 填写：单位秒，默认 60；0 表示不去重。
# WS_WAF_EVENT_SIDE_EFFECT_DEDUPE_SECONDS=60

# ============================================================
# 十三、公开脚本附加调优
# ============================================================

# 目的：定时备份 cron 表达式。
# 作用域：scripts/install-backup-cron.sh。
# 填写：默认每天 03:00；使用系统 cron 的五段格式。
# BAIZE_BACKUP_CRON_SCHEDULE='0 3 * * *'
