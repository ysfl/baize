# Baize public deployment advanced configuration template
#
# Usage:
#   1) Do not rename this file to .env.
#   2) Copy only the settings you need into .env.
#   3) Remove the leading # from copied settings and fill values as described.
#
# Scope:
#   - Commented settings use Baize built-in defaults.
#   - These settings are for larger deployments, performance tests, compliance integrations, or troubleshooting.
#   - Authorization-center identity, signing material, refresh cadence, and subscription upgrade entry are intentionally absent; Baize activation, managed system config, and signed authorization state maintain them.
#   - When a copied value contains spaces, #, $, &, ;, |, <, >, parentheses, backticks, or backslashes, wrap it in single quotes in .env.

# ============================================================
# 1. Database Pool and Schema Version Records
# ============================================================

# Purpose: max open database connections for the control service.
# Scope: control service process.
# Fill: default 50; small deployments usually use 20-60. Confirm database capacity before increasing.
# DB_MAX_OPEN_CONNS=50

# Purpose: max idle database connections for the control service.
# Scope: control service process.
# Fill: default 10; must be <= DB_MAX_OPEN_CONNS.
# DB_MAX_IDLE_CONNS=10

# Purpose: database connection max lifetime.
# Scope: control service process.
# Fill: seconds, default 1800; 0 disables lifetime recycling.
# DB_CONN_MAX_LIFETIME_SEC=1800

# Purpose: database idle connection max time.
# Scope: control service process.
# Fill: seconds, default 600; 0 disables idle-time recycling.
# DB_CONN_MAX_IDLE_TIME_SEC=600

# Purpose: SQL log level.
# Scope: control service process.
# Fill: silent, error, warn, info, or debug. Production usually uses warn or error.
# DB_GORM_LOG_LEVEL=warn

# Purpose: database schema version table override.
# Scope: control service process.
# Fill: leave empty for the default table; set only when you own a custom database update flow.
# BAIZE_DB_MIGRATION_TABLE=

# Purpose: whether Redis is required for startup and readiness.
# Scope: control service process.
# Fill: keep true in production; set false only for emergency recovery or very small trials.
# BAIZE_REDIS_REQUIRED=true

# ============================================================
# 2. CORS Details
# ============================================================

# Purpose: allowed cross-origin HTTP methods.
# Scope: control service process.
# Fill: default covers current console requests; adjust only for custom clients.
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Purpose: allowed cross-origin request headers.
# Scope: control service process.
# Fill: add custom auth or proxy headers only when needed.
# CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,Cache-Control,Pragma

# Purpose: response headers exposed to browsers.
# Scope: control service process.
# Fill: set only when the console needs to read additional response headers.
# CORS_EXPOSE_HEADERS=Content-Length,Content-Type

# Purpose: browser preflight cache duration.
# Scope: control service process.
# Fill: seconds, default 86400; lower temporarily while debugging CORS.
# CORS_MAX_AGE=86400

# ============================================================
# 3. Secret Separation and Sensitive Operation Protection
# ============================================================

# Purpose: dedicated encryption key for notification channel configuration.
# Scope: control service notification config encryption.
# Fill: optional; falls back to CREDENTIAL_MASTER_KEY when empty.
# NOTIFICATION_MASTER_KEY=

# Purpose: dedicated encryption key for AI provider API keys.
# Scope: control service AI provider config encryption.
# Fill: optional; falls back to CREDENTIAL_MASTER_KEY when empty.
# AI_PROVIDER_MASTER_KEY=

# Purpose: private key path for control messages sent to Agents.
# Scope: control service process.
# Fill: use a persistent path in production; losing it affects trust with existing Agents.
# BAIZE_SERVER_SIGNING_KEY_PATH=/app/data/keys/server_ed25519.key

# Purpose: debug bypass for host-profile sensitive operations.
# Scope: high-sensitivity operation gate.
# Fill: local development or automated validation only; keep 0 or unset in production.
# BAIZE_HOST_PROFILE_DEBUG_BYPASS=0

# Purpose: key ID for plaintext command-history reveal encryption.
# Scope: host-profile history encryption in the control service.
# Fill: default server-local; use an auditable ID during key rotation.
# HOST_PROFILE_HISTORY_CIPHER_KEY_ID=server-local

# Purpose: key for plaintext command-history reveal encryption.
# Scope: host-profile history encryption in the control service.
# Fill: 32 raw bytes or base64/base64url for 32 bytes; single-quote special characters.
# HOST_PROFILE_HISTORY_CIPHER_KEY=

# ============================================================
# 4. GeoIP Online Fallback
# ============================================================

# Purpose: online GeoIP lookup template.
# Scope: control service IP location lookup.
# Fill: used only when GEOIP_OFFLINE_ONLY=false and offline lookup misses. Must contain %s for the IP.
# GEOIP_LOOKUP_TEMPLATE=https://ipwho.is/%s

# Purpose: online GeoIP lookup timeout.
# Scope: control service IP location lookup.
# Fill: milliseconds, default 3000.
# GEOIP_LOOKUP_TIMEOUT_MS=3000

# ============================================================
# 5. WAF Defaults and Version Gates
# ============================================================

# Purpose: WAF master switch.
# Scope: control service security policy and delivery.
# Fill: default false; do not enable in production before rollout validation.
# WAF_ENABLED=false

# Purpose: default WAF mode.
# Scope: control service security policy and delivery.
# Fill: disabled, observe, or enforce. Unknown values fall back.
# WAF_DEFAULT_MODE=disabled

# Purpose: default rule-set version.
# Scope: control service security policy and delivery.
# Fill: empty means no default rule set; use release notes as the source.
# WAF_DEFAULT_RULE_SET_VERSION=

# Purpose: WAF event sampling rate.
# Scope: control service WAF event processing.
# Fill: 1 means all events, 0.1 means about 10 percent. Confirm audit needs before lowering.
# WAF_EVENT_SAMPLE_RATE=1

# Purpose: minimum Agent version allowed to enter observe mode.
# Scope: control service WAF policy.
# Fill: default 0.1.6; do not lower casually during rollout.
# WAF_MIN_OBSERVE_VERSION=0.1.6

# Purpose: minimum Agent version allowed to enter block mode.
# Scope: control service WAF policy.
# Fill: default 0.1.7; do not lower before enforcement validation.
# WAF_MIN_BLOCK_VERSION=0.1.7

# Purpose: WAF policy protocol version.
# Scope: control service and Agent WAF capability negotiation.
# Fill: keep waf.v1 unless every component is compatible with a new value.
# WAF_CONTRACT_VERSION=waf.v1

# ============================================================
# 6. AI Context and External Model
# ============================================================

# Purpose: deployment default for AI context.
# Scope: control service process; saved system settings take over after configuration.
# Fill: default false; enable only after confirming provider and data boundaries.
# BAIZE_AI_CONTEXT_ENABLED=false

# Purpose: deployment-level force-disable for AI context.
# Scope: control service process.
# Fill: set true for emergency or compliance shutdowns.
# BAIZE_AI_CONTEXT_FORCE_DISABLED=false

# Purpose: AI recommendation provider.
# Scope: control service process.
# Fill: local_rules for built-in rules, http_json for an external HTTP JSON model endpoint.
# BAIZE_AI_RECOMMENDATION_PROVIDER=local_rules

# Purpose: external model name.
# Scope: control service AI request.
# Fill: used only by http_json provider; single-quote names with spaces.
# BAIZE_AI_MODEL_NAME=

# Purpose: external model HTTP JSON endpoint.
# Scope: control service AI request.
# Fill: full http(s) URL; single-quote query strings.
# BAIZE_AI_MODEL_ENDPOINT=

# Purpose: external model API key.
# Scope: control service AI request; never returned to the console.
# Fill: single-quote special characters; long-term storage is better handled through encrypted console settings.
# BAIZE_AI_MODEL_API_KEY=

# Purpose: external model request timeout.
# Scope: control service AI request.
# Fill: seconds, default 15.
# BAIZE_AI_MODEL_TIMEOUT_SEC=15

# Purpose: external model suggested output limit.
# Scope: control service AI request.
# Fill: tokens, default 800; exact meaning depends on provider.
# BAIZE_AI_MODEL_MAX_TOKENS=800

# ============================================================
# 7. Remote Execution Output Limits
# ============================================================

# Purpose: max retained output bytes per execution target.
# Scope: remote execution output storage.
# Fill: default 1048576, or 1 MiB. Estimate total capacity before increasing.
# BAIZE_EXEC_OUTPUT_MAX_BYTES=1048576

# Purpose: retained days for execution output details.
# Scope: remote execution output cleanup.
# Fill: default 30; <=0 disables scheduled cleanup.
# BAIZE_EXEC_OUTPUT_RETENTION_DAYS=30

# Purpose: execution output cleanup interval.
# Scope: remote execution output cleanup.
# Fill: minutes, default 360.
# BAIZE_EXEC_OUTPUT_CLEANUP_INTERVAL_MINUTES=360

# Purpose: default number of output chunks returned by queries.
# Scope: remote execution output API.
# Fill: default 200; avoid increasing blindly if pages become slow.
# BAIZE_EXEC_OUTPUT_QUERY_DEFAULT_LIMIT=200

# Purpose: maximum number of output chunks returned by queries.
# Scope: remote execution output API.
# Fill: default 1000; runtime still enforces hard caps.
# BAIZE_EXEC_OUTPUT_QUERY_MAX_LIMIT=1000

# Purpose: default number of targets returned by output queries.
# Scope: remote execution output API.
# Fill: default 50; use pagination for large batch tasks.
# BAIZE_EXEC_OUTPUT_TARGET_DEFAULT_LIMIT=50

# Purpose: maximum number of targets returned by output queries.
# Scope: remote execution output API.
# Fill: default 200; prefer pagination for many targets.
# BAIZE_EXEC_OUTPUT_TARGET_MAX_LIMIT=200

# ============================================================
# 8. Dashboard, Nginx Analysis, and Operation Audit
# ============================================================

# Purpose: Dashboard pre-aggregation interval.
# Scope: Dashboard background aggregation.
# Fill: seconds, default 15; lowering it increases database pressure.
# BAIZE_DASHBOARD_AGG_INTERVAL_SECONDS=15

# Purpose: Dashboard cache TTL.
# Scope: Dashboard cache.
# Fill: seconds, default 30; usually cover at least two aggregation rounds.
# BAIZE_DASHBOARD_CACHE_TTL_SECONDS=30

# Purpose: max active groups refreshed per round.
# Scope: Dashboard background aggregation.
# Fill: default 10; increase only when many groups are active and the database has headroom.
# BAIZE_DASHBOARD_GROUP_REFRESH_BATCH_SIZE=10

# Purpose: how long an accessed group remains active.
# Scope: Dashboard background aggregation.
# Fill: minutes, default 10.
# BAIZE_DASHBOARD_GROUP_ACTIVE_TTL_MINUTES=10

# Purpose: max active group registry size.
# Scope: Dashboard background aggregation.
# Fill: default 500; oldest inactive groups are evicted after the limit.
# BAIZE_DASHBOARD_GROUP_MAX_ACTIVE=500

# Purpose: whether to prewarm all groups on startup.
# Scope: Dashboard background aggregation.
# Fill: false is recommended for larger deployments; true can help small deployments warm cache earlier.
# BAIZE_DASHBOARD_GROUP_PREWARM_ON_START=false

# Purpose: Nginx analysis table-selection cache TTL.
# Scope: Nginx analysis queries.
# Fill: seconds, default 10.
# BAIZE_NGINX_ANALYSIS_TABLE_CACHE_TTL_SECONDS=10

# Purpose: Nginx analysis table-selection cache capacity.
# Scope: Nginx analysis queries.
# Fill: default 512; entries are separated by Agent, host set, and time window.
# BAIZE_NGINX_ANALYSIS_TABLE_CACHE_MAX_ENTRIES=512

# Purpose: async operation-audit persistence queue capacity.
# Scope: operation-audit middleware.
# Fill: default 1024; increase only when audit queue drops are observed.
# BAIZE_OPERATION_AUDIT_QUEUE_CAPACITY=1024

# Purpose: async operation-audit persistence worker count.
# Scope: operation-audit middleware.
# Fill: default 2; limited by database write capacity.
# BAIZE_OPERATION_AUDIT_WORKERS=2

# ============================================================
# 9. Runtime Logs and External Export
# ============================================================

# Purpose: default number of recent runtime log lines collected in diagnostic bundles.
# Scope: diagnostic bundle creation.
# Fill: default 1000; lower it when bundles become too large.
# BAIZE_RUNTIME_LOG_DIAGNOSTIC_LINES=1000

# Purpose: runtime log hot-index retention.
# Scope: runtime log index.
# Fill: hours, default 168.
# BAIZE_RUNTIME_LOG_INDEX_RETENTION_HOURS=168

# Purpose: async queue size for runtime log hot indexing.
# Scope: runtime log index.
# Fill: default 4096; increase only if bursts cause drops.
# BAIZE_RUNTIME_LOG_INDEX_QUEUE_SIZE=4096

# Purpose: enable external log export.
# Scope: runtime log export.
# Fill: default false; enable after integrating a log platform.
# BAIZE_RUNTIME_LOG_EXPORT_ENABLED=false

# Purpose: external log export format.
# Scope: runtime log export.
# Fill: http_json or loki; must match the receiver.
# BAIZE_RUNTIME_LOG_EXPORT_FORMAT=http_json

# Purpose: external log export endpoint.
# Scope: runtime log export.
# Fill: full http(s) URL; single-quote query strings.
# BAIZE_RUNTIME_LOG_EXPORT_ENDPOINT=

# Purpose: extra request headers for external log export.
# Scope: runtime log export.
# Fill: Key=Value,Key2=Value2; single-quote spaces or special characters.
# BAIZE_RUNTIME_LOG_EXPORT_HEADERS=

# Purpose: external log export batch size.
# Scope: runtime log export.
# Fill: default 100; lower it if the receiver rate-limits.
# BAIZE_RUNTIME_LOG_EXPORT_BATCH_SIZE=100

# Purpose: external log export async queue size.
# Scope: runtime log export.
# Fill: default 4096; increase only if bursts cause drops.
# BAIZE_RUNTIME_LOG_EXPORT_QUEUE_SIZE=4096

# Purpose: external log export flush interval.
# Scope: runtime log export.
# Fill: seconds, default 5.
# BAIZE_RUNTIME_LOG_EXPORT_INTERVAL_SEC=5

# ============================================================
# 10. Version Display Overrides
# ============================================================

# Purpose: Agent version override.
# Scope: version display.
# Fill: normally provided by the release manifest; set manually only when build info is unavailable.
# BAIZE_AGENT_VERSION=0.1.39

# Purpose: control service build fingerprint.
# Scope: diagnostics, authorization activation, and version traceability.
# Fill: normally injected by the build process; use a traceable build number if set manually.
# BAIZE_SERVER_BUILD_FINGERPRINT=

# ============================================================
# 11. Background Schedulers
# ============================================================

# Purpose: heartbeat check interval.
# Scope: heartbeat checker.
# Fill: seconds, default 15; very small values increase scheduling and database load.
# HB_CHECK_INTERVAL_SEC=15

# Purpose: heartbeat timeout threshold.
# Scope: heartbeat checker.
# Fill: seconds, default 90.
# HB_CHECK_TIMEOUT_SEC=90

# Purpose: heartbeat sample persistence interval.
# Scope: heartbeat sampler.
# Fill: seconds, default 3600.
# HB_SAMPLE_INTERVAL_SEC=3600

# Purpose: certificate scan scheduler switch.
# Scope: certificate scan scheduler.
# Fill: default true; disable only if certificate monitoring is unused.
# CERT_SCAN_ENABLED=true

# Purpose: certificate scan interval.
# Scope: certificate scan scheduler.
# Fill: seconds, default 300.
# CERT_SCAN_INTERVAL_SEC=300

# Purpose: certificate scan concurrency.
# Scope: certificate scan scheduler.
# Fill: default 4; confirm network and CPU headroom before increasing.
# CERT_SCAN_CONCURRENCY=4

# Purpose: certificate scan retry count.
# Scope: certificate scan scheduler.
# Fill: default 2.
# CERT_SCAN_RETRIES=2

# Purpose: certificate scan retry delay.
# Scope: certificate scan scheduler.
# Fill: seconds, default 3.
# CERT_SCAN_RETRY_DELAY_SEC=3

# Purpose: background retry switch for failed alert delivery.
# Scope: alert retry scheduler.
# Fill: default true.
# ALERT_RETRY_ENABLED=true

# Purpose: alert retry interval.
# Scope: alert retry scheduler.
# Fill: seconds, default 60.
# ALERT_RETRY_INTERVAL_SEC=60

# Purpose: alert retry lookback window.
# Scope: alert retry scheduler.
# Fill: hours, default 24.
# ALERT_RETRY_LOOKBACK_HOURS=24

# Purpose: max alert retry candidates per round.
# Scope: alert retry scheduler.
# Fill: default 100.
# ALERT_RETRY_MAX_CANDIDATES=100

# Purpose: max retry attempts per alert.
# Scope: alert retry scheduler.
# Fill: default 3.
# ALERT_RETRY_MAX_ATTEMPTS=3

# Purpose: alert escalation scheduler switch.
# Scope: alert escalation scheduler.
# Fill: default true; disable temporarily only during troubleshooting.
# ALERT_ESCALATION_ENABLED=true

# Purpose: alert escalation scan interval.
# Scope: alert escalation scheduler.
# Fill: seconds, default 30.
# ALERT_ESCALATION_INTERVAL_SEC=30

# Purpose: max alert escalation candidates per round.
# Scope: alert escalation scheduler.
# Fill: default 100.
# ALERT_ESCALATION_MAX_CANDIDATES=100

# Purpose: metric-threshold alert checker switch.
# Scope: metric-threshold checker.
# Fill: default true; disable temporarily during tests or troubleshooting.
# ALERT_METRIC_THRESHOLD_ENABLED=true

# Purpose: metric-threshold alert check interval.
# Scope: metric-threshold checker.
# Fill: seconds, default 30.
# ALERT_METRIC_THRESHOLD_INTERVAL_SEC=30

# Purpose: number of scheduled tasks leased per round.
# Scope: distributed scheduled-task scheduler.
# Fill: default 20; tune with database capacity when tasks accumulate.
# CRON_SCHEDULER_BATCH_SIZE=20

# Purpose: scheduled-task lease duration.
# Scope: distributed scheduled-task scheduler.
# Fill: seconds, default 120.
# CRON_SCHEDULER_LEASE_SEC=120

# Purpose: backoff after targets are busy.
# Scope: distributed scheduled-task scheduler.
# Fill: seconds, default 60.
# CRON_SCHEDULER_BUSY_BACKOFF_SEC=60

# Purpose: base backoff after task failure.
# Scope: distributed scheduled-task scheduler.
# Fill: seconds, default 60.
# CRON_SCHEDULER_FAILURE_BASE_BACKOFF_SEC=60

# Purpose: max backoff after task failure.
# Scope: distributed scheduled-task scheduler.
# Fill: seconds, default 1800.
# CRON_SCHEDULER_FAILURE_MAX_BACKOFF_SEC=1800

# Purpose: consecutive failure threshold before protection.
# Scope: distributed scheduled-task scheduler.
# Fill: default 5.
# CRON_SCHEDULER_MAX_FAILURES=5

# Purpose: max active targets per Agent.
# Scope: distributed scheduled-task scheduler.
# Fill: default 1; keep the default when remote execution pressure is high.
# CRON_SCHEDULER_MAX_ACTIVE_TARGETS_PER_AGENT=1

# Purpose: scheduled-task scheduler worker ID.
# Scope: distributed scheduled-task scheduler.
# Fill: explicit unique value for multi-instance deployments; leave empty for single instance.
# CRON_SCHEDULER_WORKER_ID=

# Purpose: request-risk evaluator scheduler switch.
# Scope: request-risk evaluator scheduler.
# Fill: default true; set false only to pause evaluation temporarily.
# REQUEST_RISK_EVALUATOR_ENABLED=true

# Purpose: request-risk evaluator interval.
# Scope: request-risk evaluator scheduler.
# Fill: seconds, default 60.
# REQUEST_RISK_EVALUATOR_INTERVAL_SEC=60

# Purpose: request-risk evaluator per-round limit.
# Scope: request-risk evaluator scheduler.
# Fill: default 200; tune with database capacity in high-traffic environments.
# REQUEST_RISK_EVALUATOR_LIMIT=200

# Purpose: command approval expiry archive switch.
# Scope: command approval archive scheduler.
# Fill: default true; disable only for troubleshooting.
# COMMAND_PLAN_APPROVAL_EXPIRY_ENABLED=true

# Purpose: command approval expiry archive interval.
# Scope: command approval archive scheduler.
# Fill: seconds, default 300.
# COMMAND_PLAN_APPROVAL_EXPIRY_INTERVAL_SEC=300

# Purpose: expired approvals archived per round.
# Scope: command approval archive scheduler.
# Fill: default 50.
# COMMAND_PLAN_APPROVAL_EXPIRY_BATCH_SIZE=50

# Purpose: Runbook background auto-advance switch.
# Scope: Runbook scheduler.
# Fill: default false; keep disabled until orchestration is validated.
# RUNBOOK_SCHEDULER_ENABLED=false

# Purpose: Runbook background tick interval.
# Scope: Runbook scheduler.
# Fill: seconds, default 60.
# RUNBOOK_SCHEDULER_INTERVAL_SEC=60

# Purpose: Runbook instances scanned per round.
# Scope: Runbook scheduler.
# Fill: default 20.
# RUNBOOK_SCHEDULER_BATCH_SIZE=20

# Purpose: max ticks per Runbook instance in one scheduler round.
# Scope: Runbook scheduler.
# Fill: default 8 to prevent one instance from occupying the loop.
# RUNBOOK_SCHEDULER_MAX_TICKS_PER_INSTANCE=8

# Purpose: Runbook scheduler lease duration.
# Scope: Runbook scheduler.
# Fill: seconds, default 120.
# RUNBOOK_SCHEDULER_LEASE_SEC=120

# Purpose: Runbook scheduler worker ID.
# Scope: Runbook scheduler.
# Fill: explicit unique value for multi-instance deployments; leave empty for single instance.
# RUNBOOK_SCHEDULER_WORKER_ID=

# ============================================================
# 12. WebSocket Ingestion Queues and Workers
# ============================================================

# Purpose: system-metrics ingestion queue capacity.
# Scope: real-time metrics ingestion.
# Fill: default 256; increase only when many Agents cause queue drops.
# WS_METRICS_QUEUE_CAPACITY=256

# Purpose: system-metrics insertion worker count.
# Scope: real-time metrics ingestion.
# Fill: default 8; limited by database write capacity.
# WS_METRICS_INSERT_WORKERS=8

# Purpose: system-metrics insertion batch size.
# Scope: real-time metrics ingestion.
# Fill: default 32; observe both latency and batch efficiency.
# WS_METRICS_INSERT_BATCH_SIZE=32

# Purpose: max queued system-metrics batches per Agent.
# Scope: real-time metrics ingestion.
# Fill: default 32; avoid high values that starve other Agents.
# WS_METRICS_MAX_QUEUED_PER_AGENT=32

# Purpose: Nginx metrics ingestion queue capacity.
# Scope: Nginx metrics ingestion.
# Fill: default 128; increase only when many Agents cause queue drops.
# WS_NGINX_QUEUE_CAPACITY=128

# Purpose: Nginx metrics insertion worker count.
# Scope: Nginx metrics ingestion.
# Fill: default 4.
# WS_NGINX_INSERT_WORKERS=4

# Purpose: process metrics ingestion queue capacity.
# Scope: process metrics ingestion.
# Fill: default 128; increase only when many Agents cause queue drops.
# WS_PROCESS_QUEUE_CAPACITY=128

# Purpose: process metrics worker count.
# Scope: process metrics ingestion.
# Fill: default 4.
# WS_PROCESS_WORKERS=4

# Purpose: Docker metrics ingestion queue capacity.
# Scope: Docker metrics ingestion.
# Fill: default 128; increase only when many containers cause queue drops.
# WS_DOCKER_QUEUE_CAPACITY=128

# Purpose: Docker metrics worker count.
# Scope: Docker metrics ingestion.
# Fill: default 4.
# WS_DOCKER_WORKERS=4

# Purpose: max containers accepted from one Docker payload.
# Scope: Docker metrics ingestion.
# Fill: default 500; extra containers are dropped and counted.
# WS_DOCKER_MAX_CONTAINERS_PER_PAYLOAD=500

# Purpose: Docker event dedupe window.
# Scope: Docker metrics ingestion.
# Fill: seconds, default 60; 0 disables window dedupe.
# WS_DOCKER_EVENT_DEDUPE_SECONDS=60

# Purpose: WAF event persistence queue capacity.
# Scope: WAF event ingestion.
# Fill: default 512; increase when events accumulate.
# WS_WAF_EVENT_QUEUE_CAPACITY=512

# Purpose: WAF event persistence worker count.
# Scope: WAF event ingestion.
# Fill: default 4; limited by database write capacity.
# WS_WAF_EVENT_WORKERS=4

# Purpose: WAF side-effect queue capacity.
# Scope: WAF alert and coordinated-defense side effects.
# Fill: default 512.
# WS_WAF_EVENT_SIDE_EFFECT_QUEUE_CAPACITY=512

# Purpose: WAF side-effect worker count.
# Scope: WAF alert and coordinated-defense side effects.
# Fill: default 2.
# WS_WAF_EVENT_SIDE_EFFECT_WORKERS=2

# Purpose: max queued WAF event batches per Agent.
# Scope: WAF event ingestion.
# Fill: default 64 to prevent one Agent from occupying the whole queue.
# WS_WAF_EVENT_MAX_QUEUED_PER_AGENT=64

# Purpose: WAF event site-ID cache duration.
# Scope: WAF event ingestion.
# Fill: seconds, default 30; 0 disables caching.
# WS_WAF_EVENT_SITE_CACHE_SECONDS=30

# Purpose: WAF side-effect dedupe window.
# Scope: WAF alert and coordinated-defense side effects.
# Fill: seconds, default 60; 0 disables dedupe.
# WS_WAF_EVENT_SIDE_EFFECT_DEDUPE_SECONDS=60

# ============================================================
# 13. Public Script Extra Tuning
# ============================================================

# Purpose: cron expression for scheduled backups.
# Scope: scripts/install-backup-cron.sh.
# Fill: default is daily at 03:00. Use standard five-field system cron syntax.
# BAIZE_BACKUP_CRON_SCHEDULE='0 3 * * *'
