# Baize public deployment base configuration template
#
# Recommended path:
#   bash scripts/init-config.sh
#   or bash scripts/install.sh
# The scripts generate strong random passwords, keys, and security codes.
# For manual setup, copy this file to .env first.
#
# Scope:
#   - This base template keeps only first-install and routine-upgrade settings.
#   - Performance, queue, scheduler, external logging, and AI model tuning live in .env.advanced.en.example.
#   - Authorization-center identity, signing material, refresh cadence, and subscription upgrade entry are not .env settings; Baize activation, managed system config, and signed authorization state maintain them.
#
# Formatting and quoting:
#   - Use KEY=VALUE. Do not write export KEY=VALUE.
#   - Do not add spaces around =.
#   - Use KEY= for an explicit empty value.
#   - Use English commas for lists, for example a.example,b.example.
#   - Do not quote plain numbers or true/false values.
#   - If a password, token, URL, or command contains spaces, #, $, &, ;, |, <, >, parentheses, backticks, or backslashes, wrap it in single quotes.
#   - Avoid double quotes for secrets because scripts source .env and Bash may expand $ or backticks inside double quotes.
#   - Do not append inline comments after values, such as KEY=value # comment.

# Purpose: script prompt language.
# Scope: install, upgrade, backup, restore, and other public deployment scripts.
# Fill: zh or en.
BAIZE_LANG=en

# Purpose: select the public image and release-metadata source.
# Scope: first-install configuration.
# Fill: github uses GitHub and Docker Hub; acr uses the Alibaba Cloud registry and mainland China mirrors.
BAIZE_IMAGE_SOURCE=github

# Purpose: PostgreSQL bootstrap user.
# Scope: docker compose postgres service.
# Fill: usually keep baize; if changed, keep DB_USER aligned.
POSTGRES_USER=baize

# Purpose: PostgreSQL bootstrap password.
# Scope: postgres container and control service database connection.
# Fill: required in production; use single quotes if it contains special characters.
POSTGRES_PASSWORD=

# Purpose: PostgreSQL bootstrap database name.
# Scope: docker compose postgres service.
# Fill: usually keep baize; if changed, keep DB_NAME aligned.
POSTGRES_DB=baize

# Purpose: host port mapped to PostgreSQL container port 5432.
# Scope: docker compose variable substitution.
# Fill: default 15432; change for multiple installations on one host.
POSTGRES_PUBLIC_PORT=15432

# Purpose: TimescaleDB image.
# Scope: docker compose postgres service.
# Fill: normally selected by the installer from BAIZE_IMAGE_SOURCE.
BAIZE_POSTGRES_IMAGE=timescale/timescaledb:latest-pg16

# Purpose: Redis access password.
# Scope: redis container and control service cache connection.
# Fill: required in production; use single quotes if it contains special characters.
REDIS_PASSWORD=

# Purpose: Redis logical DB index.
# Scope: control service process.
# Fill: default 0; use 1-15 only when sharing Redis.
REDIS_DB=0

# Purpose: host port mapped to Redis container port 6379.
# Scope: docker compose variable substitution.
# Fill: default 16379; change for multiple installations on one host.
REDIS_PUBLIC_PORT=16379

# Purpose: Redis image.
# Scope: docker compose redis service.
# Fill: normally selected by the installer from BAIZE_IMAGE_SOURCE.
BAIZE_REDIS_IMAGE=redis:7-alpine

# Purpose: bind address inside the control service container.
# Scope: control service process.
# Fill: keep 0.0.0.0 for container deployment.
SERVER_HOST=0.0.0.0

# Purpose: bind port inside the control service container.
# Scope: control service process and docker compose port mapping.
# Fill: default 8080; usually change SERVER_PUBLIC_PORT instead.
SERVER_PORT=8080

# Purpose: host port exposed for the control service.
# Scope: docker compose variable substitution, checks, and access hints.
# Fill: default 22501; Agents and the console must reach this port.
SERVER_PUBLIC_PORT=22501

# Purpose: control service runtime mode.
# Scope: control service process.
# Fill: keep release in production; use debug only for local troubleshooting.
SERVER_MODE=release

# Purpose: CPU architecture for the control service image or local release artifact.
# Scope: deployment scripts and install checks.
# Fill: amd64 or arm64.
SERVER_TARGET_ARCH=amd64

# Purpose: Docker platform for the control service container.
# Scope: docker compose server service.
# Fill: linux/amd64 or linux/arm64; keep aligned with SERVER_TARGET_ARCH.
SERVER_TARGET_PLATFORM=linux/amd64

# Purpose: deployment artifact source.
# Scope: deployment scripts.
# Fill: keep image for public installs so published images are downloaded directly.
BAIZE_DEPLOY_MODE=image

# Purpose: service set to start.
# Scope: deployment scripts and docker compose profile selection.
# Fill: full starts control service and console; server-only starts only the control service.
BAIZE_STACK_MODE=full

# Purpose: Baize public release version.
# Scope: image tag fallback, version scripts, and release manifest alignment.
# Fill: normally follows releases/latest.json.
BAIZE_VERSION=0.2.1

# Purpose: control service version.
# Scope: image tag, version display, and upgrade checks.
# Fill: normally follows the release manifest.
BAIZE_SERVER_VERSION=0.2.1

# Purpose: console version.
# Scope: console image tag, version display, and upgrade checks.
# Fill: normally follows the release manifest.
BAIZE_WEB_VERSION=1.0.0

# Purpose: control service image.
# Scope: docker compose server service.
# Fill: default public image; use single quotes for private image URLs with special characters.
BAIZE_SERVER_IMAGE=ghcr.io/ysfl/baize-server:0.2.1

# Purpose: console image.
# Scope: docker compose web service.
# Fill: default public image; use single quotes for private image URLs with special characters.
BAIZE_WEB_IMAGE=ghcr.io/ysfl/baize-web:1.0.0

# Purpose: host port exposed for the console.
# Scope: docker compose web service.
# Fill: default 8088; unused in server-only mode.
WEB_PUBLIC_PORT=8088

# Purpose: console container port.
# Scope: console container.
# Fill: default 8080; usually do not change.
WEB_CONTAINER_PORT=8080

# Purpose: browser-facing API base URL.
# Scope: console runtime config.
# Fill: keep /api/v1 for same-origin deployments; use a full https://.../api/v1 URL for split domains.
WEB_API_BASE_URL=/api/v1

# Purpose: request body size accepted by the console proxy.
# Scope: console container.
# Fill: default 100m; increase only for larger file distribution or import workflows.
WEB_CLIENT_MAX_BODY_SIZE=100m

# Purpose: internal address used by the console container to reach the control service.
# Scope: console container.
# Fill: default server:8080; host or split deployments may adjust it through scripts.
BAIZE_SERVER_UPSTREAM=server:8080

# Purpose: shortcut for the primary console domain.
# Scope: console Host guard.
# Fill: optional; when set, the console accepts only this domain.
BAIZE_WEB_DOMAIN=

# Purpose: allowed Host values for console access.
# Scope: console Host guard.
# Fill: optional; use English commas for multiple domains.
BAIZE_WEB_ALLOWED_HOSTS=

# Purpose: PostgreSQL host used by the control service.
# Scope: control service process.
# Fill: keep postgres for container deployment; use an internal hostname/IP for external DB.
DB_HOST=postgres

# Purpose: PostgreSQL port used by the control service.
# Scope: control service process.
# Fill: keep 5432 for container networking; use the actual port for external DB.
DB_PORT=5432

# Purpose: PostgreSQL user used by the control service.
# Scope: control service process.
# Fill: usually the same as POSTGRES_USER.
DB_USER=baize

# Purpose: PostgreSQL password used by the control service.
# Scope: control service process.
# Fill: usually the same as POSTGRES_PASSWORD; use single quotes for special characters.
DB_PASSWORD=

# Purpose: PostgreSQL database used by the control service.
# Scope: control service process.
# Fill: usually the same as POSTGRES_DB.
DB_NAME=baize

# Purpose: PostgreSQL SSL mode.
# Scope: control service process.
# Fill: disable for the bundled database; follow provider guidance for managed databases.
DB_SSLMODE=disable

# Purpose: Redis address used by the control service.
# Scope: control service process.
# Fill: keep redis:6379 for container deployment; use host:port for external Redis.
REDIS_ADDR=redis:6379

# Purpose: enable browser CORS handling.
# Scope: control service process.
# Fill: keep true when the console and API use different domains or ports.
CORS_ENABLED=true

# Purpose: browser Origins allowed to access API and WebSocket endpoints.
# Scope: control service process.
# Fill: use exact Origins in production, for example https://console.example.com. Use English commas for multiple values.
CORS_ALLOW_ORIGINS=*

# Purpose: whether cross-origin requests may include credentials.
# Scope: control service process.
# Fill: default false. If true, CORS_ALLOW_ORIGINS must use exact Origins, not *.
CORS_ALLOW_CREDENTIALS=false

# Purpose: JWT signing secret for user login tokens.
# Scope: control service process.
# Fill: required in production, at least 32 random characters. Rotating it invalidates existing sessions.
JWT_SECRET=

# Purpose: first-install administrator username.
# Scope: local account bootstrap.
# Fill: default admin; change the password in the console after first login.
ADMIN_USERNAME=admin

# Purpose: first-install administrator password.
# Scope: local account bootstrap.
# Fill: required in production; scripts generate and store it in .env.
ADMIN_PASSWORD=

# Purpose: master key for encrypted credentials and sensitive stored settings.
# Scope: control service process.
# Fill: required in production, at least 32 random characters. Back it up offline; rotation makes old ciphertext unreadable.
CREDENTIAL_MASTER_KEY=

# Purpose: hash of the security code for host-profile refresh and plaintext command-history reveal.
# Scope: high-sensitivity operation gate.
# Fill: recommended in production; clear the plaintext value after setting a hash.
BAIZE_HOST_PROFILE_SECURITY_CODE_HASH=

# Purpose: plaintext security code for host-profile refresh and plaintext command-history reveal.
# Scope: first install or reset bootstrap.
# Fill: generated by scripts; in stable production prefer a hash and clear this value.
BAIZE_HOST_PROFILE_SECURITY_CODE=

# Purpose: whether the control service terminates TLS itself.
# Scope: control service process.
# Fill: keep false when HTTPS is terminated by Nginx, Caddy, or a load balancer.
TLS_ENABLED=false

# Purpose: TLS certificate PEM path.
# Scope: control service process, only when TLS_ENABLED=true.
# Fill: path readable inside the container; reverse-proxy TLS is usually preferred.
TLS_CERT_FILE=

# Purpose: TLS private key PEM path.
# Scope: control service process, only when TLS_ENABLED=true.
# Fill: path readable inside the container and restricted to the control service.
TLS_KEY_FILE=

# Purpose: Agent release artifact directory inside the control service container.
# Scope: remote install and upgrade entry.
# Fill: keep /app/agent/dist for container deployment.
AGENT_ARTIFACT_DIR=/app/agent/dist

# Purpose: Linux/macOS Agent install script path.
# Scope: generated install commands and download endpoint.
# Fill: keep /app/agent/dist/install.sh for container deployment.
AGENT_INSTALL_SCRIPT_PATH=/app/agent/dist/install.sh

# Purpose: Windows Agent install script path.
# Scope: generated install commands and download endpoint.
# Fill: keep /app/agent/dist/install.ps1 for container deployment.
AGENT_INSTALL_POWERSHELL_PATH=/app/agent/dist/install.ps1

# Purpose: external control service URL reachable by Agents.
# Scope: Agent registration, install, upgrade, and download links.
# Fill: replace 127.0.0.1 with the real IP or domain before onboarding remote Agents. Do not add a trailing slash. The server-host executor does not depend on this URL.
AGENT_PUBLIC_SERVER_URL=http://127.0.0.1:22501

# Purpose: automatically install the server-host executor after deployment.
# Scope: public deployment scripts.
# Fill: default true; the script skips safely when host privileges are unavailable and prints a manual command.
BAIZE_SERVER_HOST_AGENT_ENABLED=true

# Purpose: internal control service URL used by the server-host executor.
# Scope: server-host executor auto-install.
# Fill: leave empty to use http://127.0.0.1:${SERVER_PUBLIC_PORT}; set only for special port mappings.
BAIZE_SERVER_HOST_AGENT_INTERNAL_URL=

# Purpose: TTL for temporary upgrade tokens generated automatically.
# Scope: remote Agent upgrade flow.
# Fill: hours; default 24.
AGENT_UPGRADE_AUTO_TOKEN_TTL_HOURS=24

# Purpose: official website URL in the managed-login notice.
# Scope: delivered by the control service to Agents.
# Fill: keep the default official URL for normal deployments.
BAIZE_LOGIN_NOTICE_OFFICIAL_SITE_URL=https://baize.run

# Purpose: community URL in the managed-login notice.
# Scope: delivered by the control service to Agents.
# Fill: keep the default official community URL for normal deployments.
BAIZE_LOGIN_NOTICE_DISCORD_URL=https://discord.gg/UMR7mnZFqh

# Purpose: Telegram community URL in the managed-login notice.
# Scope: delivered by the control service to Agents.
# Fill: keep the default official community URL for normal deployments.
BAIZE_LOGIN_NOTICE_TELEGRAM_URL=https://t.me/+y3n_66PfRSw0ZDRl

# Purpose: support URL in the managed-login notice.
# Scope: delivered by the control service to Agents.
# Fill: http(s) URL or mailto; use single quotes for query strings.
BAIZE_LOGIN_NOTICE_SUPPORT_URL=mailto:support@baize.run

# Purpose: abuse-report URL in the managed-login notice.
# Scope: delivered by the control service to Agents.
# Fill: http(s) URL or mailto; use single quotes for query strings.
BAIZE_LOGIN_NOTICE_ABUSE_REPORT_URL=mailto:support@baize.run

# Purpose: SHA-256 hash of a deployment-level secret that allows disabling the managed-login notice.
# Scope: high-sensitivity control service gate.
# Fill: empty means disabling is not allowed; set a 64-character SHA-256 only after official confirmation.
BAIZE_LOGIN_NOTICE_DISABLE_SECRET_SHA256=

# Purpose: endpoint for managed-login disable-event reporting.
# Scope: control service risk reporting.
# Fill: keep the default official endpoint; reporting failure does not block local audit.
BAIZE_LOGIN_NOTICE_REPORT_ENDPOINT=https://baize.run/api/v1/security/login-notice/disable-events

# Purpose: token for managed-login disable-event reporting.
# Scope: control service risk reporting.
# Fill: optional; use single quotes for special characters.
BAIZE_LOGIN_NOTICE_REPORT_TOKEN=

# Purpose: offline City database path.
# Scope: control service IP location lookup.
# Fill: keep this container path; install local GeoIP data before checks.
GEOIP_CITY_MMDB_PATH=/app/runtime/geoip/dbip-city-lite.mmdb

# Purpose: offline ASN database path.
# Scope: control service IP location lookup.
# Fill: keep this container path; install local GeoIP data before checks.
GEOIP_ASN_MMDB_PATH=/app/runtime/geoip/dbip-asn-lite.mmdb

# Purpose: whether to use only offline GeoIP/ASN databases.
# Scope: control service IP location lookup.
# Fill: true is recommended in production to avoid runtime public lookups.
GEOIP_OFFLINE_ONLY=true

# Purpose: automatically prepare offline GeoIP databases during first install.
# Scope: public deployment scripts.
# Fill: default true; when the network is unavailable, installation continues with a warning.
BAIZE_AUTO_INSTALL_GEOIP=true

# Purpose: write local rolling runtime log files.
# Scope: control service process.
# Fill: true is recommended in production for diagnostics.
BAIZE_RUNTIME_LOG_FILE_ENABLED=true

# Purpose: runtime log directory.
# Scope: control service process.
# Fill: keep /app/data/logs/baize-server for container deployment.
BAIZE_RUNTIME_LOG_DIR=/app/data/logs/baize-server

# Purpose: max size of one runtime log file.
# Scope: control service process.
# Fill: MB; default 50.
BAIZE_RUNTIME_LOG_FILE_MAX_SIZE_MB=50

# Purpose: number of local rolling log files to keep.
# Scope: control service process.
# Fill: default 7; reduce for small disks.
BAIZE_RUNTIME_LOG_FILE_MAX_FILES=7

# Purpose: enable database hot index for runtime logs.
# Scope: control service process.
# Fill: default true; disable only for very small deployments.
BAIZE_RUNTIME_LOG_INDEX_ENABLED=true

# Purpose: current release manifest path.
# Scope: version display and upgrade checks.
# Fill: keep /app/releases/manifest.env for container deployment.
BAIZE_RELEASE_MANIFEST_PATH=/app/releases/manifest.env

# Purpose: control service build-info path.
# Scope: version display, diagnostics, and upgrade checks.
# Fill: keep /app/server/dist/build-info.env for container deployment.
BAIZE_SERVER_BUILD_INFO_PATH=/app/server/dist/build-info.env

# Purpose: Agent build-info path.
# Scope: version display, diagnostics, and upgrade checks.
# Fill: keep /app/agent/dist/build-info.env for container deployment.
BAIZE_AGENT_BUILD_INFO_PATH=/app/agent/dist/build-info.env

# Purpose: remote latest-version manifest.
# Scope: version checks and upgrade prompts.
# Fill: default public manifest; private deployments may use their own URL.
BAIZE_LATEST_MANIFEST_URL=https://raw.githubusercontent.com/ysfl/baize/main/releases/latest.json

# Purpose: remote changelog manifest.
# Scope: version detail display.
# Fill: default public manifest; private deployments may use their own URL.
BAIZE_RELEASE_CHANGELOG_URL=https://raw.githubusercontent.com/ysfl/baize/main/releases/changelog.json

# Purpose: default mode for console-triggered upgrades.
# Scope: control service upgrade entry.
# Fill: keep manual unless command execution and rollback have been reviewed.
BAIZE_UPGRADE_MODE=manual

# Purpose: legacy upgrade command.
# Scope: control service upgrade entry, only when BAIZE_UPGRADE_RUNNER_ENABLED=true.
# Fill: leave empty by default; commands with spaces or special characters must be single-quoted and reviewed.
BAIZE_UPGRADE_COMMAND=

# Purpose: Docker orchestration upgrade command.
# Scope: control service upgrade entry, only when BAIZE_UPGRADE_RUNNER_ENABLED=true.
# Fill: leave empty by default; verify idempotency, audit, and rollback before enabling.
BAIZE_DOCKER_UPGRADE_COMMAND=

# Purpose: host release-artifact upgrade command.
# Scope: control service upgrade entry, only when BAIZE_UPGRADE_RUNNER_ENABLED=true.
# Fill: leave empty by default; verify idempotency, audit, and rollback before enabling.
BAIZE_HOST_UPGRADE_COMMAND=

# Purpose: allow the control service to execute upgrade commands.
# Scope: control service upgrade entry.
# Fill: keep false until security review and rollback validation are complete.
BAIZE_UPGRADE_RUNNER_ENABLED=false

# Purpose: upgrade task log directory.
# Scope: control service upgrade entry.
# Fill: keep /app/data/upgrade for container deployment.
BAIZE_UPGRADE_LOG_DIR=/app/data/upgrade

# Purpose: update database structure on control service startup.
# Scope: control service process.
# Fill: keep true for single-instance deployments; set false only when an external database update flow owns it.
BAIZE_DB_AUTO_MIGRATE=true

# Purpose: backup root directory.
# Scope: backup, restore, cleanup, and reinitialization scripts.
# Fill: leave empty for the per-installation default; prefer a path outside the repository.
BAIZE_BACKUP_DIR=

# Purpose: backup retention days.
# Scope: backup cleanup and backup cron scripts.
# Fill: default 14; increase only after confirming disk capacity.
BAIZE_BACKUP_KEEP_DAYS=14
