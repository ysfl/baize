# Baize public deployment configuration template
#
# Recommended path:
#   Run scripts/init-config.sh or scripts/install.sh to generate .env with
#   strong random passwords and secrets. Use this file only as a reference for
#   manual configuration or automation.
#
# Formatting rules:
#   - Use KEY=VALUE. Do not add spaces around = and do not write export.
#   - Use KEY= for an explicit empty value.
#   - Use English commas for lists, for example: a.example,b.example.
#   - If a secret, URL, or command contains spaces, #, $, &, ;, |, <, >,
#     parentheses, backticks, or backslashes, wrap it in single quotes.
#   - Avoid double quotes for secrets because Bash may still expand $ and
#     backticks when scripts source .env.
#   - Do not append inline comments after values.

# Language used by Baize scripts. Use zh or en.
BAIZE_LANG=en

# PostgreSQL container bootstrap user, password, database, and host port.
# Generate a strong password for production.
POSTGRES_USER=baize
POSTGRES_PASSWORD=
POSTGRES_DB=baize
POSTGRES_PUBLIC_PORT=15432

# Redis password, logical DB index, and host port.
# Leave REDIS_PASSWORD empty only for local/private deployments.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PUBLIC_PORT=16379

# Central service bind address, container port, and public host port.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_PUBLIC_PORT=22501
SERVER_MODE=release

# Target platform for the central service image/artifact.
SERVER_TARGET_ARCH=amd64
SERVER_TARGET_PLATFORM=linux/amd64

# Deployment mode:
#   auto  - choose image/build based on available artifacts
#   image - pull published images
#   build - build from local release artifacts
BAIZE_DEPLOY_MODE=auto

# Stack mode:
#   full        - central service + console
#   server-only - central service only
BAIZE_STACK_MODE=full

# Version and image tags. Keep these aligned with releases/latest.json unless
# you intentionally pin a version.
BAIZE_VERSION=0.1.39
BAIZE_SERVER_VERSION=0.1.39
BAIZE_WEB_VERSION=0.1.38
BAIZE_SERVER_IMAGE=ghcr.io/ysfl/baize-server:0.1.39
BAIZE_WEB_IMAGE=ghcr.io/ysfl/baize-web:0.1.38

# Console host/container ports and API base path.
# WEB_API_BASE_URL=/api/v1 is recommended for same-origin deployments.
WEB_PUBLIC_PORT=8088
WEB_CONTAINER_PORT=8080
WEB_API_BASE_URL=/api/v1
WEB_CLIENT_MAX_BODY_SIZE=100m
BAIZE_SERVER_UPSTREAM=server:8080

# Optional console domain access policy.
# When set, the console only accepts these Host values. Use commas for multiple
# domains. Leave empty for first install or temporary intranet access.
BAIZE_WEB_DOMAIN=
BAIZE_WEB_ALLOWED_HOSTS=

# Database connection used by the central service inside Docker Compose.
DB_HOST=postgres
DB_PORT=5432
DB_USER=baize
DB_PASSWORD=
DB_NAME=baize
DB_SSLMODE=disable

# Redis connection used by the central service inside Docker Compose.
REDIS_ADDR=redis:6379

# Login and encryption secrets.
# Generate strong random values for JWT_SECRET, ADMIN_PASSWORD, and
# CREDENTIAL_MASTER_KEY. Back up CREDENTIAL_MASTER_KEY; rotating it makes old
# encrypted credentials unreadable.
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
CREDENTIAL_MASTER_KEY=

# High-sensitivity operation security code for host-profile refresh and
# plaintext command-history reveal. New installs may bootstrap with plaintext;
# production can replace it with a hash and clear the plaintext value.
BAIZE_HOST_PROFILE_SECURITY_CODE_HASH=
BAIZE_HOST_PROFILE_SECURITY_CODE=

# CORS settings. For production, prefer exact Origins instead of *.
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# TLS settings for the central service itself. Leave disabled when TLS is
# terminated by a reverse proxy or gateway.
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# Agent distribution paths inside the central service container.
AGENT_ARTIFACT_DIR=/app/agent/dist
AGENT_INSTALL_SCRIPT_PATH=/app/agent/dist/install.sh
AGENT_INSTALL_POWERSHELL_PATH=/app/agent/dist/install.ps1

# Public URL reachable by managed Agents. Replace 127.0.0.1 with your real
# server IP or domain before onboarding Agents outside the host.
AGENT_PUBLIC_SERVER_URL=http://127.0.0.1:22501
AGENT_UPGRADE_AUTO_TOKEN_TTL_HOURS=24

# Login notice links shown on managed hosts.
BAIZE_LOGIN_NOTICE_OFFICIAL_SITE_URL=https://baize.run
BAIZE_LOGIN_NOTICE_DISCORD_URL=https://discord.gg/UMR7mnZFqh
BAIZE_LOGIN_NOTICE_SUPPORT_URL=mailto:support@baize.run
BAIZE_LOGIN_NOTICE_ABUSE_REPORT_URL=mailto:support@baize.run
BAIZE_LOGIN_NOTICE_DISABLE_SECRET_SHA256=
BAIZE_LOGIN_NOTICE_REPORT_ENDPOINT=https://baize.run/api/v1/security/login-notice/disable-events
BAIZE_LOGIN_NOTICE_REPORT_TOKEN=

# Offline GeoIP / ASN database paths inside the central service container.
GEOIP_CITY_MMDB_PATH=/app/runtime/geoip/dbip-city-lite.mmdb
GEOIP_ASN_MMDB_PATH=/app/runtime/geoip/dbip-asn-lite.mmdb
GEOIP_OFFLINE_ONLY=true

# Central service runtime logs and diagnostics.
BAIZE_RUNTIME_LOG_FILE_ENABLED=true
BAIZE_RUNTIME_LOG_DIR=/app/data/logs/baize-server
BAIZE_RUNTIME_LOG_FILE_MAX_SIZE_MB=50
BAIZE_RUNTIME_LOG_FILE_MAX_FILES=7
BAIZE_RUNTIME_LOG_INDEX_ENABLED=true

# Release metadata and update checks.
BAIZE_RELEASE_MANIFEST_PATH=/app/releases/manifest.env
BAIZE_SERVER_BUILD_INFO_PATH=/app/server/dist/build-info.env
BAIZE_AGENT_BUILD_INFO_PATH=/app/agent/dist/build-info.env
BAIZE_LATEST_MANIFEST_URL=https://raw.githubusercontent.com/ysfl/baize/main/releases/latest.json
BAIZE_RELEASE_CHANGELOG_URL=https://raw.githubusercontent.com/ysfl/baize/main/releases/changelog.json

# Optional console-triggered upgrade command settings.
# Keep the runner disabled unless you have reviewed the command path and
# rollback process for your deployment.
BAIZE_UPGRADE_MODE=manual
BAIZE_UPGRADE_COMMAND=
BAIZE_DOCKER_UPGRADE_COMMAND=
BAIZE_HOST_UPGRADE_COMMAND=
BAIZE_UPGRADE_RUNNER_ENABLED=false
BAIZE_UPGRADE_LOG_DIR=/app/data/upgrade

# Database startup migration toggle.
BAIZE_DB_AUTO_MIGRATE=true

# Backup location and retention. Leave BAIZE_BACKUP_DIR empty to use the
# default per-installation backup directory.
BAIZE_BACKUP_DIR=
BAIZE_BACKUP_KEEP_DAYS=14
